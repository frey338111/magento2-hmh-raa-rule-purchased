<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="hmh_review_customer" resource="default" engine="innodb" comment="Review Customer Verified Purchase">
        <column xsi:type="bigint" name="review_customer_id" unsigned="true" nullable="false" identity="true" padding="20" comment="Review Customer ID"/>
        <column xsi:type="bigint" name="review_id" unsigned="true" nullable="false" padding="20" comment="Review ID"/>
        <column xsi:type="int" name="customer_id" unsigned="true" nullable="false" padding="10" comment="Customer ID"/>
        <column xsi:type="boolean" name="verified_purchase" nullable="false" default="false" comment="Verified Purchase"/>

        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="review_customer_id"/>
        </constraint>

        <constraint xsi:type="foreign"
                    referenceId="HMH_REVIEW_CUSTOMER_REVIEW_ID_REVIEW_REVIEW_ID"
                    table="hmh_review_customer"
                    column="review_id"
                    referenceTable="review"
                    referenceColumn="review_id"
                    onDelete="CASCADE"/>

        <constraint xsi:type="unique" referenceId="HMH_REVIEW_CUSTOMER_REVIEW_ID_UNQ">
            <column name="review_id"/>
        </constraint>

        <index referenceId="HMH_REVIEW_CUSTOMER_CUSTOMER_ID" indexType="btree">
            <column name="customer_id"/>
        </index>
    </table>
</schema>

